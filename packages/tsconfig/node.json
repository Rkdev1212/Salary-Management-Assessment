{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "Node",
	"extends": "./base.json",
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "CommonJS",
		"moduleResolution": "node",
		"types": ["node"],
		"outDir": "dist",
		"rootDir": "src",
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true
	}
}
